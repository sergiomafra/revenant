{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window may call: the core defaults, the app's commands, and opening the About links (only those addresses) in the browser.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/sergiomafra/revenant" },
        { "url": "https://github.com/sergiomafra/revenant#readme" }
      ]
    }
  ]
}
